# Copiá este archivo a .env y ajustá los valores.
# Lo leen tanto `vite.config.js` (modo dev) como webterm-server (modo prod).
# Nada de esto es obligatorio: sin .env, todo arranca con los defaults de abajo.

# --- red -----------------------------------------------------------------
# Puerto del servidor de producción (webterm-server / npm start).
WEBTERM_PORT=3001
# Interfaz donde escucha el servidor de producción.
#   127.0.0.1 = solo esta máquina (default, más seguro)
#   0.0.0.0   = toda la red — usalo solo detrás de un proxy TLS o con TOKEN puesto
WEBTERM_HOST=127.0.0.1
# Puerto del servidor de desarrollo (npm run dev / vite).
WEBTERM_DEV_PORT=5190
# Ruta del WebSocket.
WEBTERM_WS_PATH=/ws

# --- seguridad -------------------------------------------------------------
# Token requerido para conectar (?token=... en la URL). Sin esto, cualquiera
# que llegue al puerto tiene una shell. Generalo con: openssl rand -hex 16
WEBTERM_TOKEN=

# --- shell -----------------------------------------------------------------
# Shell a lanzar (default: $SHELL del sistema, o bash).
#WEBTERM_SHELL=/bin/bash
# Directorio inicial de cada sesión (default: $HOME).
#WEBTERM_CWD=/root

# --- sesiones ----------------------------------------------------------------
# Segundos que sobrevive una sesión tras cerrar la pestaña/perder conexión.
#   0   = se mata al desconectar (sin persistencia)
#   inf = nunca se mata sola (útil en dev; en prod preferí un número)
WEBTERM_SESSION_TIMEOUT=600
# Sesiones (shells) simultáneas permitidas en el servidor.
WEBTERM_MAX_SESSIONS=50
# Bytes de scrollback que se re-envían al reconectar.
WEBTERM_SCROLLBACK_BYTES=200000

# --- archivos (subir/bajar desde la terminal) -------------------------------
# Poné 0 para desactivar por completo las rutas de archivos.
WEBTERM_FILES=1
WEBTERM_FILES_PATH=/webterm-files
WEBTERM_MAX_UPLOAD_MB=500
